# Copie para .env e preencha. O .env nunca vai para o Git.
# Tudo aqui vai para o navegador: só valores públicos.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (sb_publishable_...) ou, em projetos antigos, a "anon".
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: lembretes por Web Push. Gere o par com `npx web-push generate-vapid-keys`
# e coloque a chave PÚBLICA aqui (a privada vai só nos secrets do Supabase).
VITE_VAPID_PUBLIC_KEY=

# Opcional: e-mail exibido nos Termos e na Política de Privacidade.
# Sem ele, o contato aponta para a página do projeto no GitHub.
VITE_CONTATO_EMAIL=
