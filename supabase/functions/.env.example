# Secrets das Edge Functions. Não preencha aqui: configure no Supabase com
#   npx supabase secrets set NOME=valor
# (ou em Project Settings > Edge Functions > Secrets).

# Obrigatório: chave da Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional: modelo da Gemini. Padrão: gemini-3.5-flash-lite
GEMINI_MODEL=
# Recomendado em produção: origens que podem chamar as funções, separadas por vírgula
ALLOWED_ORIGINS=https://seu-dominio.com.br
# Opcional, só para os lembretes por Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
CRON_SECRET=
